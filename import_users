#!/bin/ash
# shellcheck shell=ash
#
#  Creates tutorial users, assigns them to groups, and configures roles and
#  Authorization Services in the farm-management Keycloak realm.
#  Runs inside the quay.io/curl/curl container on the fiware_default network.

set -e

KC="http://${KEYCLOAK_HOST:-keycloak}:${KEYCLOAK_PORT:-8080}"
REALM="farm-management"

# ── Obtain admin token ────────────────────────────────────────────────────────
# Wait for Keycloak to fully bootstrap
sleep 10
ADMIN_TOKEN=$(curl -s -X POST "${KC}/realms/master/protocol/openid-connect/token" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  --data-urlencode "grant_type=password" \
  --data-urlencode "client_id=admin-cli" \
  --data-urlencode "username=admin" \
  --data-urlencode "password=1234" \
  | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])")

echo "Admin token obtained"

# ── Helper functions ──────────────────────────────────────────────────────────
create_user () {
  local USERNAME="$1" FIRST="$2" LAST="$3" EMAIL="$4" PASSWORD="$5"
  curl -s -o /dev/null -X POST "${KC}/admin/realms/${REALM}/users" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" \
    -H "Content-Type: application/json" \
    --data-raw "{
      \"username\": \"${USERNAME}\",
      \"firstName\": \"${FIRST}\",
      \"lastName\": \"${LAST}\",
      \"email\": \"${EMAIL}\",
      \"enabled\": true,
      \"credentials\": [{\"type\": \"password\", \"value\": \"${PASSWORD}\", \"temporary\": false}]
    }"
  echo "Created user: ${USERNAME}"
}

get_user_id () {
  curl -s "${KC}/admin/realms/${REALM}/users?username=$1&exact=true" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['id'])"
}

get_group_id () {
  curl -s "${KC}/admin/realms/${REALM}/groups?search=$1&exact=true" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" \
    | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['id'])"
}

get_role_id () {
  curl -s "${KC}/admin/realms/${REALM}/roles/$1" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['id'])"
}

assign_to_group () {
  local UID
  UID=$(get_user_id "$1")
  local GID
  GID=$(get_group_id "$2")
  curl -s -o /dev/null -X PUT \
    "${KC}/admin/realms/${REALM}/users/${UID}/groups/${GID}" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}"
  echo "Assigned $1 → $2"
}

assign_realm_role_to_group () {
  local GID
  GID=$(get_group_id "$1")
  local ROLE_JSON
  ROLE_JSON=$(curl -s "${KC}/admin/realms/${REALM}/roles/$2" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}")
  curl -s -o /dev/null -X POST \
    "${KC}/admin/realms/${REALM}/groups/${GID}/role-mappings/realm" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" \
    -H "Content-Type: application/json" \
    --data-raw "[${ROLE_JSON}]"
  echo "Assigned role $2 → group $1"
}

# ── Create users ──────────────────────────────────────────────────────────────
create_user "alice"  "Alice"  "Administrator" "alice@fiware.farm"  "test"
create_user "bob"    "Bob"    "Farmer"        "bob@fiware.farm"    "test"
create_user "carol"  "Carol"  "Livestock"     "carol@fiware.farm"  "test"
create_user "dave"   "Dave"   "Crops"         "dave@fiware.farm"   "test"
create_user "eve"    "Eve"    "Equipment"     "eve@fiware.farm"    "test"
create_user "frank"  "Frank"  "Worker"        "frank@fiware.farm"  "test"
create_user "grace"  "Grace"  "Worker"        "grace@fiware.farm"  "test"
create_user "harry"  "Harry"  "Irrigation"    "harry@fiware.farm"  "test"
create_user "ivy"    "Ivy"    "Tractor"       "ivy@fiware.farm"    "test"
create_user "jenny"  "Jenny"  "Veterinarian"  "jenny@fiware.farm"  "test"
create_user "ken"    "Ken"    "Agronomist"    "ken@fiware.farm"    "test"

# ── Assign users to groups ────────────────────────────────────────────────────
assign_to_group "bob"   "farm-management"
assign_to_group "carol" "livestock-team"
assign_to_group "frank" "livestock-team"
assign_to_group "grace" "livestock-team"
assign_to_group "dave"  "crop-team"
assign_to_group "harry" "crop-team"
assign_to_group "eve"   "equipment-team"
assign_to_group "ivy"   "equipment-team"
assign_to_group "jenny" "external-consultants"
assign_to_group "ken"   "external-consultants"

# ── Assign realm roles to groups ──────────────────────────────────────────────
assign_realm_role_to_group "farm-management"     "farm-manager"
assign_realm_role_to_group "livestock-team"      "livestock-supervisor"
assign_realm_role_to_group "crop-team"           "crop-supervisor"
assign_realm_role_to_group "equipment-team"      "equipment-supervisor"
assign_realm_role_to_group "external-consultants" "read-only-consultant"

# ── Grant farm-manager role directly to bob as well ──────────────────────────
BOB_ID=$(get_user_id "bob")
ROLE_JSON=$(curl -s "${KC}/admin/realms/${REALM}/roles/farm-manager" \
  -H "Authorization: Bearer ${ADMIN_TOKEN}")
curl -s -o /dev/null -X POST \
  "${KC}/admin/realms/${REALM}/users/${BOB_ID}/role-mappings/realm" \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  -H "Content-Type: application/json" \
  --data-raw "[${ROLE_JSON}]"
echo "Assigned farm-manager role directly to bob"

# ── Retrieve client UUID for Authorization Services setup ─────────────────────
CLIENT_UUID=$(curl -s "${KC}/admin/realms/${REALM}/clients?clientId=ngsi-ld-farm" \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['id'])")

echo "Client UUID: ${CLIENT_UUID}"

# ── Create Authorization Scopes (HTTP methods) ────────────────────────────────
for SCOPE in GET POST PATCH DELETE; do
  curl -s -o /dev/null -X POST \
    "${KC}/admin/realms/${REALM}/clients/${CLIENT_UUID}/authz/resource-server/scope" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" \
    -H "Content-Type: application/json" \
    --data-raw "{\"name\": \"${SCOPE}\", \"displayName\": \"HTTP ${SCOPE}\"}"
  echo "Created scope: ${SCOPE}"
done

# ── Create Resource: Entity Collection ────────────────────────────────────────
curl -s -o /dev/null -X POST \
  "${KC}/admin/realms/${REALM}/clients/${CLIENT_UUID}/authz/resource-server/resource" \
  -H "Authorization: Bearer ${ADMIN_TOKEN}" \
  -H "Content-Type: application/json" \
  --data-raw '{
    "name": "Entity Collection",
    "displayName": "NGSI-LD Entity Collection endpoint",
    "uris": ["/ngsi-ld/v1/entities", "/ngsi-ld/v1/entities/*"],
    "scopes": [{"name": "GET"}, {"name": "POST"}, {"name": "PATCH"}, {"name": "DELETE"}]
  }'
echo "Created resource: Entity Collection"

# ── Create Role Policies ──────────────────────────────────────────────────────
for ROLE in farm-manager livestock-supervisor crop-supervisor equipment-supervisor read-only-consultant; do
  ROLE_ID=$(get_role_id "${ROLE}")
  curl -s -o /dev/null -X POST \
    "${KC}/admin/realms/${REALM}/clients/${CLIENT_UUID}/authz/resource-server/policy/role" \
    -H "Authorization: Bearer ${ADMIN_TOKEN}" \
    -H "Content-Type: application/json" \
    --data-raw "{
      \"name\": \"${ROLE} policy\",
      \"roles\": [{\"id\": \"${ROLE_ID}\", \"required\": false}]
    }"
  echo "Created policy: ${ROLE} policy"
done

echo ""
echo "Tutorial data loaded successfully"
